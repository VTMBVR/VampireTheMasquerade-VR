				m_nNodeID = {
					m_id = 1328133352
				}
				m_networkMode = "ServerAuthoritative"
				m_commentText = "Turn Helper nodes look at how much rotation their child node produces, and then looks at the current target heading.  If the child node's rotation would turn the character too little or too much, the Turn Helper will make up the difference so by the time the animation is done the character will face the target exactly\n"
