<root>
    <styles>
        <include src="s2r://panorama/styles/custom_game/vtmbvr_dialog.vcss_c" />
        <include src="s2r://panorama/styles/custom_game/vtmbvr_dialog_window.vcss_c" />
    </styles>
    <scripts>
        <include src="s2r://panorama/scripts/custom_game/vtmbvr_dialog_data.vjs_c" />
        <include src="s2r://panorama/scripts/custom_game/vtmbvr_source_data.vjs_c" />
        <include src="s2r://panorama/scripts/custom_game/vtmbvr_font_data.vjs_c" />
        <include src="s2r://panorama/scripts/custom_game/vtmbvr_font.vjs_c" />
        <include src="s2r://panorama/scripts/custom_game/vtmbvr_dialog.vjs_c" />
        <include src="s2r://panorama/scripts/custom_game/vtmbvr_dialog_window.vjs_c" />
    </scripts>
    <ClientUIDialogPanel class="DialogueRoot VTMBVRInput" hittest="true" hittestchildren="true">
        <Panel id="DialogueFrame" hittest="false" hittestchildren="true" class="DialogueFrame">
            <Panel class="OriginalFrameInset" hittest="false" />
            <Image class="OriginalCornerTL" src="file://{images}/custom_game/vtmbvr/dialog_corner_tl.png" hittest="false" />
            <Image class="OriginalCornerBR" src="file://{images}/custom_game/vtmbvr/dialog_corner_br.png" hittest="false" />
            <Panel class="DialogueContent" hittest="false" hittestchildren="true">
            <Panel id="DialogueHeading" hittest="false" hittestchildren="true" class="Heading">
                <Label hittest="false" class="Kicker" text="THE ASYLUM" />
                <Panel hittest="false" id="DialogueSpeaker" class="Speaker" />
            </Panel>
            <Panel hittest="false" id="DialogueText" class="Speech" />
            <Panel hittest="false" id="DialogueLastReply" class="LastReply" />
            <Panel hittest="false" hittestchildren="true" id="DialogueChoices" class="Choices">
                <Button hittest="true" id="DialogueChoice1" class="Choice" onactivate="VTMBVRDialog.choose(0)"><Panel hittest="false" id="DialogueAnswer1" /></Button>
                <Button hittest="true" id="DialogueChoice2" class="Choice" onactivate="VTMBVRDialog.choose(1)"><Panel hittest="false" id="DialogueAnswer2" /></Button>
                <Button hittest="true" id="DialogueChoice3" class="Choice" onactivate="VTMBVRDialog.choose(2)"><Panel hittest="false" id="DialogueAnswer3" /></Button>
                <Button hittest="true" id="DialogueChoice4" class="Choice" onactivate="VTMBVRDialog.choose(3)"><Panel hittest="false" id="DialogueAnswer4" /></Button>
            </Panel>
            <Button id="DialoguePage" class="Choice SourcePage" onactivate="VTMBVRDialog.tool(4)"><Panel id="DialoguePageText" hittest="false" /></Button>
            <Button hittest="true" id="DialogueRestart" class="Choice Restart" onactivate="VTMBVRDialog.restart()"><Label hittest="false" text="Начать разговор заново" /></Button>
            <Label id="DialogueFootnote" hittest="false" class="Footnote" text="Выберите ответ" />
            </Panel>
        </Panel>

        <Panel id="DialogueGrabHandle" class="WindowGrabHandle" hittest="false"><Panel id="DialogueGrabText" hittest="false" /></Panel>
        <Button id="DialogueTuning" class="TuneToggle ToolButton" onactivate="VTMBVRDialog.tool(7)"><Label text="⋯" /></Button>
        <Panel id="FaceEditor" class="FaceEditor" hittest="false" hittestchildren="true">
            <Panel id="FaceEditorBackground" class="FaceEditorBackground" hittest="false" />
            <Label id="FaceEditorTitle" class="FaceEditorTitle" text="МИМИКА" hittest="false" />
            <Label id="FaceEditorLine" class="FaceEditorLine" hittest="false" />
            <Button id="FaceMode" class="ToolButton FaceMode" onactivate="VTMBVRDialog.tool(2)"><Label id="FaceModeText" /></Button>
            <Button id="FacePrev" class="ToolButton FacePrev" onactivate="VTMBVRDialog.tool(0)"><Label text="‹" /></Button>
            <Label id="FacePage" class="FacePage" hittest="false" />
            <Button id="FaceNext" class="ToolButton FaceNext" onactivate="VTMBVRDialog.tool(1)"><Label text="›" /></Button>
            <Panel id="FaceRow1" class="FaceRow" hittest="false">
                <Label id="FaceName1" class="FaceName" hittest="false" />
                <Label id="FaceValue1" class="FaceValue" hittest="false" />
                <Panel class="FaceTrack" hittest="false"><Panel id="FaceFill1" class="FaceFill" hittest="false" /><Panel id="FaceKnob1" class="FaceKnob" hittest="false" /></Panel>
            </Panel>
            <Panel id="FaceRow2" class="FaceRow" hittest="false">
                <Label id="FaceName2" class="FaceName" hittest="false" />
                <Label id="FaceValue2" class="FaceValue" hittest="false" />
                <Panel class="FaceTrack" hittest="false"><Panel id="FaceFill2" class="FaceFill" hittest="false" /><Panel id="FaceKnob2" class="FaceKnob" hittest="false" /></Panel>
            </Panel>
            <Panel id="FaceRow3" class="FaceRow" hittest="false">
                <Label id="FaceName3" class="FaceName" hittest="false" />
                <Label id="FaceValue3" class="FaceValue" hittest="false" />
                <Panel class="FaceTrack" hittest="false"><Panel id="FaceFill3" class="FaceFill" hittest="false" /><Panel id="FaceKnob3" class="FaceKnob" hittest="false" /></Panel>
            </Panel>
            <Panel id="FaceRow4" class="FaceRow" hittest="false">
                <Label id="FaceName4" class="FaceName" hittest="false" />
                <Label id="FaceValue4" class="FaceValue" hittest="false" />
                <Panel class="FaceTrack" hittest="false"><Panel id="FaceFill4" class="FaceFill" hittest="false" /><Panel id="FaceKnob4" class="FaceKnob" hittest="false" /></Panel>
            </Panel>
            <Panel id="FaceRow5" class="FaceRow" hittest="false">
                <Label id="FaceName5" class="FaceName" hittest="false" />
                <Label id="FaceValue5" class="FaceValue" hittest="false" />
                <Panel class="FaceTrack" hittest="false"><Panel id="FaceFill5" class="FaceFill" hittest="false" /><Panel id="FaceKnob5" class="FaceKnob" hittest="false" /></Panel>
            </Panel>
            <Panel id="FaceRow6" class="FaceRow" hittest="false">
                <Label id="FaceName6" class="FaceName" hittest="false" />
                <Label id="FaceValue6" class="FaceValue" hittest="false" />
                <Panel class="FaceTrack" hittest="false"><Panel id="FaceFill6" class="FaceFill" hittest="false" /><Panel id="FaceKnob6" class="FaceKnob" hittest="false" /></Panel>
            </Panel>
            <Button id="FaceLoop" class="ToolButton FaceLoop" onactivate="VTMBVRDialog.tool(8)"><Label id="FaceLoopText" /></Button>
            <Button id="FaceBack" class="ToolButton FaceBack" onactivate="VTMBVRDialog.tool(7)"><Label text="К диалогу" /></Button>
            <Button id="FaceReset" class="ToolButton FaceReset" onactivate="VTMBVRDialog.tool(3)"><Label text="Вернуть сохранённое" /></Button>
            <Button id="FaceSave" class="ToolButton FaceSave" onactivate="VTMBVRDialog.tool(9)"><Label text="Сохранить" /></Button>
            <Label id="FaceStatus" class="FaceStatus" hittest="false" />
        </Panel>
        <Button id="DialogueClose" class="CloseButton" onactivate="VTMBVRDialog.close()"><Label hittest="false" text="×" /></Button>
        <Panel id="DialoguePointer" class="Pointer" hittest="false" hittestchildren="false" />
    </ClientUIDialogPanel>
</root>
